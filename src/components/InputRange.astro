---
interface Props {
  id:string
  min: number
  max: number
  value: number
}

const { id, min, max, value } = Astro.props
---
<input type="range" id={id} min={min} max={max} value={value} class="w-full my-2 cursor-pointer accent-[#625195] dark:accent-[#CC8EA5] dark:drop-shadow-[0_0_6px_#CC8EA5]">