<div id="dappled-light">
  <div id="glow"></div>
  <div id="glow-bounce"></div>
  <div class="perspective">
    <div id="leaves"></div>
    <div id="blinds">
      <div class="shutters">
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
        <div class="shutter"></div>
      </div>
      <div class="vertical"></div>
    </div>
  </div>
  <div id="progressive-blur">
    <div></div>
    <div></div>
    <div></div>
    <div></div>
  </div>
</div>

<style>
  #dappled-light {
    pointer-events: none;
    position: fixed;
    height: 100vh;
    width: 100vw;
    background-color: var(--light);
    animation: var(--anim-name) var(--anim-duration) linear forwards;
    z-index: -1;
    
    #glow, #glow-bounce {
      position: absolute;
      height: 100%;
      width: 100%;
      opacity: 0.5;
      transition: background 1s var(--timing-fn);
    }

    #glow {
      background: linear-gradient(120deg, var(--bounce-light), var(--bounce-light) 20%, transparent);
    }
    
    #glow-bounce {
      background: linear-gradient(355deg, var(--bounce-light) 0%, transparent 30%, transparent 100%);
      bottom: 0;
    }

    .perspective {
      position: absolute;
      top: -30vh;
      right: 0;
      width: 80vw;
      height: 130vh;
      opacity:var(--perspective-opacity);
      background-blend-mode: darken;
      transform-origin: top right;
      transform-style: preserve-3d;
      transform: var(--perspective-transform);
      transition: transform 1.7s var(--timing-fn), opacity 4s ease;
  
      #blinds {
        position: relative;
        width: 100%;
        
        .shutters {
          display: flex;
          flex-direction: column;
          align-items: flex-end;
          gap: var(--shutters-gap);
          transition: gap 1s var(--timing-fn);
          
          .shutter {
            background-color: var(--shadow);
            width: 100%;
            height: var(--shutter-height);
            transition: height 1s var(--timing-fn);
          }
        }
        
        .vertical {
          background-color: var(--shadow);
          position: fixed;
          height: 100%;
          right: 20vw;
          top: 0;
          width: 40px;
        }
      }

      #leaves {
        position: absolute;
        inset: -10px;
        right: -500px;
        background-image: url("/branch.webp");
        background-size: cover;
        background-repeat: no-repeat;
        animation: billow 8s ease-in-out infinite;
      }    
    }


    #progressive-blur {
      position: absolute;
      height: 100%;
      width: 100%;

      div {
        position: absolute;
        inset: 0;
        height: 100%;
        width: 100%;
        backdrop-filter: blur(var(--blur-amount));
        mask-image: linear-gradient(252deg, transparent, transparent var(--stop1), black var(--stop2), black);
      }

      div:nth-child(1) {
        --blur-amount: 6px;
        --stop1: 0%;
        --stop2: 0%;
      }

      div:nth-child(2) {
        --blur-amount: 12px;
        --stop1: 40%;
        --stop2: 90%;
      }

      div:nth-child(3) {
        --blur-amount: 48px;
        --stop1: 40%;
        --stop2: 70%;
      }

      div:nth-child(4) {
        --blur-amount: 96px;
        --stop1: 70%;
        --stop2: 80%;
      }
    }
  }

  @keyframes sunrise {
    0% { background-color: var(--night); }
    10% { background-color: var(--dawn); }
    35% { background-color: var(--morning); }
    100% { background-color: var(--day); }
  }

  @keyframes sunset {
    0% { background-color: var(--day); }
    30% { background-color: var(--evening); }
    60% { background-color: var(--dusk); }
    90% { background-color: var(--dawn); }
    100% { background-color: var(--night); }
  }

  @keyframes billow {
    0% { transform: perspective(400px) rotateX(0deg) rotateY(0deg) scale(1); }
    25% { transform: perspective(400px) rotateX(1deg) rotateY(2deg) scale(1.03); }
    50% { transform: perspective(400px) rotateX(-4deg) rotateY(-2deg) scale(0.95); }
    75% { transform: perspective(400px) rotateX(1deg) rotateY(-1deg) scale(1.04); }
    100% { transform: perspective(400px) rotateX(0deg) rotateY(0deg) scale(1); }
  }
</style>
