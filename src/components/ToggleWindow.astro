---
import Window from "../../public/Window.astro"
import WindowOff from "../../public/WindowOff.astro"
---
<button aria-label="ThemeToggle" onclick="off()" class="fixed bottom-3 left-3 p-1 group transition">
  <Window id="on" class="size-6 sm:size-8 dark:text-gray-200 group-hover:scale-110 group-active:scale-100" />
  <WindowOff id="off" class="hidden size-6 sm:size-8 dark:text-gray-200 group-hover:scale-110 group-active:scale-100" />
</button>

<script is:inline>
  const off = () => { 
    document.getElementById("dappled-light").classList.toggle("hidden")
    document.getElementById("on").classList.toggle("hidden")
    document.getElementById("off").classList.toggle("hidden")
  }
</script>