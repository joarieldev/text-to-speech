---
import Play from '../../public/Play.astro'
import Stop from '../../public/Stop.astro'
import Record from '../../public/Record.astro'
import Alert from '../components/Alert.astro'
import InputRange from '../components/InputRange.astro'
import Dropdown from '../components/Dropdown.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import Layout from '../layouts/Layout.astro'
import Button from '../components/Button.astro'
import ToggleWindow from '../components/ToggleWindow.astro'
---

<Layout title="TextoVoz" description="Convierte tu texto escrito a voz natural">
	<main class="w-full max-w-screen-lg px-5 max-sm:pt-4 sm:my-12 m-4 min-w-[320px] rounded-lg bg-white/30 border border-black/10 dark:bg-gray-200/20 dark:border-gray-200/20" style="backdrop-filter: blur(8px);">
		<header class="text-2xl font-bold leading-[4rem] max-sm:text-xl dark:text-white dark:drop-shadow-[0_0_8px_#f3f4f6]">
			TextoVoz
		</header>
		<section class="flex flex-col gap-6">
			<article class="flex gap-6 flex-wrap max-sm:justify-center dark:text-white">
				<div class="grid gap-2 w-full max-w-[125px] sm:max-w-[150px] relative">
					<label for="btnIdioma" class="dark:drop-shadow-[0_0_6px_#f3f4f6]">Idioma</label>
					<Dropdown btnId="btnIdioma" boxId="boxIdioma" listId="idioma" />
				</div>
				<div class="grid gap-2 w-full max-w-[125px] sm:max-w-[250px] relative">
					<label for="btnVoz" class="dark:drop-shadow-[0_0_6px_#f3f4f6]">Voz</label>
					<Dropdown btnId="btnVoz" boxId="boxVoz" listId="voz" />
				</div>
				<div class="grid gap-2 w-full max-w-[125px] sm:max-w-[150px]">
					<label for="velocidad" class="dark:drop-shadow-[0_0_6px_#f3f4f6]">Velocidad</label>
					<InputRange id="velocidad" min={0} max={10} value={5}/>
				</div>
				<div class="grid gap-2 w-full max-w-[125px] sm:max-w-[150px]">
					<label for="volumen" class="dark:drop-shadow-[0_0_6px_#f3f4f6]">Volumen</label>
					<InputRange id="volumen" min={0} max={10} value={10}/>
				</div>
			</article>
			<fieldset id="boxArea" class="border p-2 rounded-lg border-black/10 bg-white/40  dark:text-white dark:bg-gray-200/20 dark:border-gray-200/20">
				<legend>
					<div class="flex gap-2 justify-center">
						<Button id="play" title="reproducir">
							<Play class="group-active:scale-90 text-green-600"/>
						</Button>
						<Button id="stop" title="parar">
							<Stop class="group-active:scale-90 text-gray-600" />
						</Button>
						<Button id="record" title="grabar" classAlt="relative">
							<span id="icon-record-anim" class="absolute hidden animate-ping size-4 left-0 right-0 top-0 bottom-0 m-auto rounded-full bg-red-500 opacity-75"></span>
							<Record class="group-active:scale-90 text-red-600"/>						
						</Button>
					</div>
				</legend>
				<textarea id="text" placeholder="Aqui tu mensaje de texto" class="p-1 w-full min-h-64 h-full sm:h-96 outline-none bg-transparent dark:text-white resize-none dark:drop-shadow-[0_0_8px_#f3f4f6] txt-area-scroll placeholder:dark:text-gray-200/50"/>
			</fieldset>
		</section>
		<footer class="text-center leading-[2rem] text-sm text-black/70 dark:text-white/70 dark:drop-shadow-[0_0_4px_rgb(229,231,235,0.7)]">
			Creado por 👨‍💻@joarieldev
		</footer>
	</main>
	<ThemeToggle />
	<Alert />
	<ToggleWindow />
</Layout>

<style>
	.txt-area-scroll {
		scrollbar-width: thin;
    scrollbar-color: #ffffff96 #dfdfdf8c;
	}
</style>

<script is:inline>
	const idiomaSelect = document.getElementById("idioma")
	const btnIdioma = document.getElementById("btnIdioma")
	const boxIdioma = document.getElementById("boxIdioma")
	const vozSelect = document.getElementById("voz")
	const btnVoz = document.getElementById("btnVoz")
	const boxVoz = document.getElementById("boxVoz")
	const playButton = document.getElementById("play")
	const stopButton = document.getElementById("stop")
	const recordButton = document.getElementById("record")
	const velocidadInput = document.getElementById("velocidad")
	const volumenInput = document.getElementById("volumen")
	const textTextArea = document.getElementById("text")
	const iconRecordAnim = document.getElementById("icon-record-anim")

	const synth = speechSynthesis
	const message = new SpeechSynthesisUtterance()
	const recognition = new webkitSpeechRecognition()
	recognition.continuous = true
	recognition.lang = 'es-AR'
	synth.cancel()

	let recordController = new AbortController()
	let idiomaFilter = []
	let isRecording = false

	synth.onvoiceschanged = () => {
		const mySet = new Set()
		synth.getVoices().forEach(voice => {
			mySet.add(voice.lang)
		})
		const esItem = Array.from(mySet).filter(item => item.startsWith("es"))
		const otherItems = Array.from(mySet).filter(item => !item.startsWith("es"))
		const options = [...esItem, ...otherItems].map(item => {
			return `<li class="block px-4 py-2 hover:bg-white/40 cursor-pointer truncate">${item}</li>`
		})
		btnIdioma.querySelector("span").innerHTML = 'Seleccione'
		options.unshift('<li class="block px-4 py-2 hover:bg-white/40 cursor-pointer truncate">Seleccione</li>')
		idiomaSelect.innerHTML = options.join('')
	}
	
	btnIdioma.addEventListener("click", () => {
		event.stopPropagation()
		boxIdioma.classList.toggle("hidden")
	})
	
	btnVoz.addEventListener("click", () => {
		event.stopPropagation()
		boxVoz.classList.toggle("hidden")
	})

	document.addEventListener("click", (event) => {
		if (!boxIdioma.classList.contains("hidden")) {
			boxIdioma.classList.add("hidden");
		}
		if (!boxVoz.classList.contains("hidden")) {
			boxVoz.classList.add("hidden");
		}
	});
	
	idiomaSelect.addEventListener("click", (e) => {
		if (e.target.tagName === 'LI') {
			const value = e.target.textContent
			idiomaFilter = synth.getVoices().filter(item=>item.lang === value)
			const options = idiomaFilter.map((voice) => {
				return `<li class="block px-4 py-2 hover:bg-white/40 cursor-pointer truncate">${voice.name}</li>`
			})
			options.unshift('<li class="block px-4 py-2 hover:bg-white/40 cursor-pointer truncate">Seleccione</li>')
			btnIdioma.querySelector("span").innerHTML = value
			btnVoz.querySelector("span").innerHTML = idiomaFilter.length !== 0 ? 'Seleccione' : 'Sin resultados'
			vozSelect.innerHTML = idiomaFilter.length !== 0 ? options.join('') : '<li class="block px-4 py-2 hover:bg-white/40 cursor-pointer truncate">Sin resultados</li>'
		}
	})

	vozSelect.addEventListener("click", (e) => {
		if (e.target.tagName === 'LI') {
			const value = e.target.textContent
			voiceFind = idiomaFilter.find(item => item.name === value)
			btnVoz.querySelector("span").innerHTML = value
		}
	})

	playButton.addEventListener("click", () => {
		synth.cancel()
		if (isRecording) {
			endRecording()
		}
		const value = btnVoz.querySelector("span").textContent
		const voiceFind = idiomaFilter.find(item => item.name === value)
		if (textTextArea.value !== '' && voiceFind) {
			message.text = textTextArea.value
			message.voice = voiceFind
			message.rate = velocidadInput.value/5
			message.volume = volumenInput.value/10
			synth.speak(message)
		}else{
			if (textTextArea.value === '') {
				warningAnimation("boxArea")
			}
			if (!voiceFind) {
				warningAnimation("btnIdioma")
				warningAnimation("btnVoz")
			}
		}
	})

	stopButton.addEventListener("click", () => {
		synth.cancel()
		if (isRecording) {
			endRecording()
		}
	})

	recordButton.addEventListener("click", () => {
		synth.cancel()
		if(!isRecording){
			startRecording()
		}else{
			endRecording()
		}
	})
	const startRecording = () => {
		isRecording = true
		recognition.start()
		iconRecordAnim.classList.remove("hidden")
		recognition.addEventListener('result', (event) => {
			const transcript = Array.from(event.results)
				.map((result) => result[0])
				.map((result) => result.transcript)
				.join(' ')
			textTextArea.value = transcript
		},{
      signal: recordController.signal
    })
	}
	const endRecording = () => {
		isRecording=false
		recognition.stop()
		iconRecordAnim.classList.add("hidden")
		recordController.abort()
    recordController = new AbortController()
	}

	const warningAnimation = (id) => {
		let delay = 0;
		for (let i = 0; i < 3; i++) {
			setTimeout(() => {
				document.getElementById(id).classList.add("ring-1", "ring-red-500")
				setTimeout(() => {
					document.getElementById(id).classList.remove("ring-1", "ring-red-500")
				}, 500);
			}, delay);
			delay += 1000
		}
	}

	//Manejo del scroll para input-range
	const scrollInputRange = (e, input) => {
		if (e.deltaY < 0) {
				input.value = Math.min(parseInt(input.value) + 1, input.max)
		} else {
				input.value = Math.max(parseInt(input.value) - 1, input.min)
		}
	}
	velocidadInput.addEventListener("wheel", (e) => {
		e.preventDefault()
		scrollInputRange(e, velocidadInput)
	},{passive:false})
	volumenInput.addEventListener("wheel", (e) => {
		e.preventDefault()
		scrollInputRange(e, volumenInput)
	},{passive:false})

</script>
